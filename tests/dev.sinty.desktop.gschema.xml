<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="dev.sinty.desktop" path="/dev/sinty/desktop/">
    <key name="wallpaper-favorites" type="as"><default>[]</default></key>
    <key name="wallpaper-effect" type="s">
      <choices>
        <choice value="none"/>
        <choice value="grayscale"/>
        <choice value="blur"/>
      </choices>
      <default>'none'</default>
    </key>
    <key name="wallpaper-effect-blur-radius" type="i">
      <range min="1" max="64"/>
      <default>8</default>
    </key>
    <key name="wallpaper-rotation-min-width" type="i"><range min="1" max="16384"/><default>1280</default></key>
    <key name="wallpaper-rotation-min-height" type="i"><range min="1" max="16384"/><default>720</default></key>
    <key name="wallpaper-rotation-match-aspect" type="b"><default>false</default></key>
    <key name="wallpaper-rotation-favor-favorites" type="b"><default>true</default></key>
  </schema>
</schemalist>
